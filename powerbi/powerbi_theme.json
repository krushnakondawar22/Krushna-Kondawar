{
  "name": "Smart Placement Dark Glass",
  "dataColors": [
    "#06B6D4",
    "#6366F1",
    "#10B981",
    "#EF4444",
    "#8B5CF6",
    "#F59E0B",
    "#EC4899",
    "#14B8A6"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#06B6D4",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 8
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "radius": 12,
            "show": true
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 12
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#06B6D4"
              }
            },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
